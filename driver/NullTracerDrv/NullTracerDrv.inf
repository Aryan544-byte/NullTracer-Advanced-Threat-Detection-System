;
; NullTracerDrv.inf — NullTracer Kernel Driver
; =============================================
; Driver installation file for NullTracerDrv.sys (kernel-mode, WDM legacy).
;
; This INF is minimal — it creates a service entry in the registry that allows
; sc.exe / setup_testsign.ps1 to load the driver with:
;   sc create NullTracer type= kernel binPath= <path>\NullTracerDrv.sys
;   sc start NullTracer
;
; For a production driver, extend with a Device class, hardware IDs, and a
; co-installer for KMDF runtime installation.
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = "System"
ClassGuid   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ManufacturerName%
DriverVer   = 09/16/2026, 1.0.0.0
CatalogFile = NullTracerDrv.cat

[DestinationDirs]
DefaultDestDir = 12        ; %windir%\System32\drivers

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
NullTracerDrv.sys = 1,,

; ============================================================================
; Default Install section
; ============================================================================
[DefaultInstall.NTamd64]
CopyFiles = NullTracerDrv_CopyFiles

[DefaultInstall.NTamd64.Services]
AddService = NullTracer, 0x002, NullTracerDrv_Service

[NullTracerDrv_CopyFiles]
NullTracerDrv.sys

; ============================================================================
; Service installation
; ============================================================================
[NullTracerDrv_Service]
DisplayName    = %ServiceDisplayName%
ServiceType    = 1                 ; SERVICE_KERNEL_DRIVER
StartType      = 3                 ; SERVICE_DEMAND_START
ErrorControl   = 1                 ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\NullTracerDrv.sys
LoadOrderGroup = FSFilter Activity Monitor

; ============================================================================
; Strings
; ============================================================================
[Strings]
ManufacturerName    = "NullTracer Project"
DiskName            = "NullTracer Driver Installation Disk"
ServiceDisplayName  = "NullTracer Kernel Threat Detection Driver"
